# Copy to .env (never commit .env).
# NASA Image and Video Library needs no key. api.nasa.gov (APOD) does; DEMO_KEY works for testing.
NASA_API_KEY=DEMO_KEY

# YouTube Data API v3 (only needed when publish.mode = upload)
# Download OAuth client JSON from Google Cloud Console -> place at secrets/client_secret.json
YOUTUBE_CLIENT_SECRET_PATH=secrets/client_secret.json
YOUTUBE_TOKEN_PATH=secrets/youtube.token.json
