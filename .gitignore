__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
build/
dist/
.venv/
.env

# Runtime data (ledger, downloaded imagery, rendered video)
data/*
output/*
!data/.gitkeep
!output/.gitkeep

# OAuth tokens for YouTube upload
secrets/
*.token.json
client_secret*.json

# Audio masters stay out of git; the normalised .m4a that `romanfeed music add`
# writes under assets/music/<genre>/ IS committed so the CI runner can use it.
assets/music/**/*.mp3
assets/music/**/*.wav
assets/music/**/*.flac
assets/music/**/*.aiff
assets/music/masters/
