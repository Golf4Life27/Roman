[Unit]
Description=Live lane "two": sessions at 07:30 and 19:30 Chicago (fires 10 min early to prepare)

[Timer]
# Keep in step with live.lanes "two" starts in the channel config.
OnCalendar=*-*-* 07:20:00 America/Chicago
OnCalendar=*-*-* 19:20:00 America/Chicago
# A missed session is skipped, never run late into the next one.
Persistent=false
AccuracySec=1min
Unit=romanfeed-lane@two.service

[Install]
WantedBy=timers.target
