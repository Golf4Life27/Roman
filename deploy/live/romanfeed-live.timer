[Unit]
Description=Nightly Space Screens live stream (21:00 Chicago, DST-aware)

[Timer]
OnCalendar=*-*-* 21:00:00 America/Chicago
# A night missed (server down at 21:00) is skipped, never run late: a stream
# starting at 3 AM would still run ~10 h into the next day.
Persistent=false
AccuracySec=1min

[Install]
WantedBy=timers.target
