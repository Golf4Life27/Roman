# /etc/romanfeed/env -- read by both systemd services. Keep it 0600, owner romanfeed.

# Fine-grained personal access token: repository Golf4Life27/Roman only,
# permission "Actions: read". Used to list and download the daily
# render-<run_id> artifacts. Nothing else.
GITHUB_TOKEN=github_pat_REPLACE_ME

# The channel's persistent stream key: Studio -> Create -> Go live -> Stream
# -> "Stream key". The server always sends to this key.
YOUTUBE_STREAM_KEY=PASTE_STREAM_KEY

# YouTube shows a stream only when a broadcast exists for it, and Studio
# makes one only while its Stream page is open. So when a token with
# youtube.force-ssl is at /etc/romanfeed/youtube.token.json (0600, owner
# romanfeed; `setup.sh --youtube-token` installs it), each night the server
# creates the broadcast itself (auto-start, auto-stop, a title for tonight)
# on this key's stream before it starts sending. Without the token it streams
# all the same, and only shows up if Studio has a broadcast ready.
# YOUTUBE_TOKEN_PATH=/etc/romanfeed/youtube.token.json
